# PostgreSQL 연결 문자열 (Supabase 사용 시 Connection Pooling URL 권장)
DATABASE_URL="postgresql://user:password@localhost:5432/newsletter?schema=public"

# Resend API 키 (https://resend.com/api-keys)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# 발신자 이메일 주소 (Resend에 등록/인증된 도메인 사용)
EMAIL_FROM="Newsletter <newsletter@yourdomain.com>"

# 배포된 서비스의 절대 URL (인증/구독해지 링크 생성에 사용)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 인증 토큰 만료 시간(분). 미설정 시 1440(24시간) 사용
CONFIRM_TOKEN_TTL_MINUTES="1440"

# IP당 분당 허용 요청 수. 미설정 시 3 사용
RATE_LIMIT_PER_MINUTE="3"

# 관리자 구독자 목록 페이지(/admin/subscribers?key=...) 접근용 비밀키.
# 미설정 시 해당 페이지는 항상 접근이 차단된다.
ADMIN_SECRET="change-me-to-a-long-random-value"
